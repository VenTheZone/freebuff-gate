# Copy to .env and fill in. Never commit the real .env.
# Default deployment: docker compose up -d --build

# --- Caddy / public HTTPS (default) ---
# Public DNS A/AAAA record must point at this host. Ports 80 and 443 must be
# reachable for Let's Encrypt HTTP-01 validation and phone HTTPS/WSS traffic.
RELAY_DOMAIN=relay.example.com
# Optional local smoke overrides; leave unset for production 80/443.
# CADDY_HTTP_PORT=18080
# CADDY_HTTPS_PORT=18443

# --- Relay secrets (required) ---
# Generate with: openssl rand -base64 32
RELAY_ENROLLMENT_TOKEN=
RELAY_ADMIN_TOKEN=
# Optional legacy shared connector secret.
RELAY_CONNECTOR_TOKEN=

# --- Optional relay settings ---
RELAY_ALLOWED_ORIGIN=
RELAY_APP_URL=
RELAY_UI_URL=

# iOS APNs: mount the .p8 key file into the container (see compose keys mount)
# and point FB_APNS_KEY at the container path, e.g. /keys/AuthKey.p8.
FB_APNS_KEY=
FB_APNS_KEY_ID=
FB_APNS_TEAM_ID=
FB_APNS_TOPIC=
FB_APNS_SANDBOX=

# --- Tailscale private-network fallback (docker-compose.tailscale.yml) ---
# Use instead of RELAY_DOMAIN when phones and server share a tailnet.
TS_AUTHKEY=
TS_HOSTNAME=freebuff-relay
TS_HTTPS_HOSTNAME=
RELAY_HTTP_URL=https://freebuff-relay.<your-tailnet>.ts.net
RELAY_WS_URL=wss://freebuff-relay.<your-tailnet>.ts.net
# Optional flags, e.g. --accept-dns=false --advertise-tags=tag:freebuff-relay.
TS_EXTRA_UP_FLAGS=--accept-dns=false
