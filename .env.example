# Copy to .env and fill in real values. .env is git-ignored.
# Real .env files are never committed.

FB_UI_AUTH_TOKEN=change-me
FB_UI_HOST=127.0.0.1
FB_UI_PORT=8793

# Mobile pairing gateway. Keep relay/app URLs on HTTPS/WSS in production.
FB_MOBILE_GATEWAY_HOST=127.0.0.1
FB_MOBILE_GATEWAY_PORT=8794
FB_MOBILE_APP_URL=https://mobile.example.invalid/pair
FB_MOBILE_RELAY_URL=https://relay.example.invalid
FB_MOBILE_RELAY_HTTP_URL=https://relay.example.invalid
FB_MOBILE_RELAY_WS_URL=wss://relay.example.invalid
# Desktop companion defaults; installer reads these but never stores token.
FB_MOBILE_UI_URL=http://127.0.0.1:58061
# Optional one-command release bootstrap overrides. Pin a version in production.
# FB_MOBILE_CONNECT_VERSION=v0.1.0
# FB_MOBILE_CONNECT_RELEASE_BASE_URL=https://github.com/VenTheZone/freebuff-gate/releases/download/v0.1.0
# FB_MOBILE_CONNECTOR_ID=desktop-main
# Relay connector/admin values are secrets; keep real values only in .env.
# FB_MOBILE_RELAY_ENROLLMENT_TOKEN=replace-with-a-random-bootstrap-secret
# FB_MOBILE_RELAY_CONNECTOR_TOKEN=legacy-shared-connector-secret
# FB_MOBILE_RELAY_ADMIN_TOKEN=replace-with-a-random-admin-secret
# Required when binding gateway beyond loopback. Keep real value only in .env.
# FB_MOBILE_ADMIN_TOKEN=replace-with-a-random-secret
# Optional; default stays outside this repository under ~/.config/freebuff/.
# FB_MOBILE_STATE_FILE=/absolute/path/to/mobile-connect.json
# FB_MOBILE_RELAY_CONNECTOR_STATE_FILE=/absolute/path/to/mobile-relay-connectors.json
# FB_MOBILE_RELAY_CONNECTOR_CREDENTIAL_FILE=/absolute/path/to/mobile-connect-connector.json
